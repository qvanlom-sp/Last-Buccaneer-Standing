<svg class="ship-grid" viewBox="@(Game.Ship.Decks == 1 ? "0 73 540 220" : "0 0 540 356")" aria-label="Isometric ship grid">
    <path class="ship-grid-water" d="M25 262h75m10 21h44m225 -23h72m-19 20h88m-95 -191h66M36 89h63" />
    @foreach (var deck in DeckOrder())
    {
        var active = deck == Selected.Deck;
        <g @key="deck" class="grid-deck @(active ? "active" : "inactive")" aria-hidden="@(!active ? "true" : null)">
            @for (var row = 0; row < Game.Ship.Rows; row++)
            {
                @for (var column = 0; column < Game.Ship.Columns; column++)
                {
                    var cell = new DeckPosition(column, row, deck);
                    var mount = Game.MountAt(cell);
                    var fitted = mount?.Cannon is { } cannon ? Campaign.Cannons[(int)cannon].Name :
                        mount?.Barricade == true ? "Barricade" : "Empty";
                    var label = $"Deck {deck + 1}, row {row + 1}, column {column + 1}: {fitted}";
                    <g @key="cell" class="deck-cell @(cell == Selected ? "chosen" : null)" transform="@Project(cell)"
                       role="@(active ? "button" : null)" tabindex="@(active ? 0 : null)"
                       aria-label="@(active ? label : null)" aria-pressed="@(active ? cell == Selected : null)"
                       @onclick="() => Choose(cell, active)" @onkeydown="args => KeySelect(args, cell, active)">
                        <title>@label</title>
                        <path class="grid-side" d="M-25 0 0 13 25 0v8L0 21-25 8Z" />
                        <path class="grid-top" d="M0 -13 25 0 0 13-25 0Z" />
                        @if (mount?.Barricade == true)
                        {
                            <path class="grid-wall" d="M-9 -7 8 -2 8 7-9 2Zm17 5 4 -3v9L8 7Z" />
                        }
                        else if (mount?.Cannon is not null)
                        {
                            <path class="grid-gun" d="M-10 0-5 -5 1 -3 10 -5l3 4L4 2 1 6Z" />
                            @if (mount.GunnerId.HasValue)
                            {
                                <circle class="grid-gunner" cx="-7" cy="-6" r="3" />
                            }
                        }
                    </g>
                }
            }
        </g>
    }
    <g class="grid-labels" transform="@(Game.Ship.Decks == 1 ? "translate(0 -49)" : "translate(0 16)")" aria-hidden="true">
        <path d="M128 297H65m0 0 9 -5m-9 5 9 5M410 297h65m0 0-9 -5m9 5-9 5" />
        <text x="65" y="322" text-anchor="start">Bow</text>
        <text x="475" y="322" text-anchor="end">Stern</text>
    </g>
</svg>

@code {
    [Parameter, EditorRequired] public Campaign Game { get; set; } = default!;
    [Parameter] public DeckPosition Selected { get; set; }
    [Parameter] public EventCallback<DeckPosition> OnSelect { get; set; }

    private IEnumerable<int> DeckOrder()
    {
        for (var deck = 0; deck < Game.Ship.Decks; deck++)
        {
            if (deck != Selected.Deck) yield return deck;
        }
        yield return Selected.Deck;
    }

    private string Project(DeckPosition cell)
    {
        var x = 270 + 42 * cell.Row - 42 * cell.Column - 21 * (Game.Ship.Rows - Game.Ship.Columns);
        var y = 178 + 22 * (cell.Row + cell.Column) - 11 * (Game.Ship.Rows + Game.Ship.Columns - 2)
            + 30 * (Game.Ship.Decks - 1) - 60 * cell.Deck;
        return $"translate({x} {y})";
    }

    private Task Choose(DeckPosition cell, bool active) => active ? OnSelect.InvokeAsync(cell) : Task.CompletedTask;
    private Task KeySelect(KeyboardEventArgs args, DeckPosition cell, bool active) =>
        args.Key == "Enter" ? Choose(cell, active) : Task.CompletedTask;
}
