<div class="outfit">
    <aside class="panel side-panel equipment-palette" aria-labelledby="equipment-heading">
        <h2 id="equipment-heading">Equipment</h2>
        <div class="equipment-tools">
            @foreach (var kind in Enum.GetValues<CannonKind>())
            {
                var spec = Campaign.Cannons[(int)kind];
                var available = Game.Available(kind);
                <div class="equipment-row">
                    <button class="equipment-tool" aria-pressed="@(tool == Tool.Cannon && cannon == kind)"
                            aria-label="Place @spec.Name" disabled="@(available <= 0)" @onclick="() => SelectCannon(kind)">
                        <EquipmentIcon Cannon="kind" />
                        <span><strong>@spec.Name</strong><small>@available in reserve</small></span>
                    </button>
                    @if (Game.AtBasecamp)
                    {
                        <button class="button equipment-buy" disabled="@(Game.Save.Gold < spec.Cost)"
                                @onclick="() => Change(Game.Buy(kind))" aria-label="Buy @spec.Name for @spec.Cost doubloons">@spec.Cost</button>
                    }
                </div>
            }
            <div class="equipment-row">
                <button class="equipment-tool" aria-pressed="@(tool == Tool.Barricade)" aria-label="Place barricade"
                        disabled="@(Game.AvailableBarricades <= 0)" @onclick="() => SelectTool(Tool.Barricade)">
                    <EquipmentIcon Barricade="true" />
                    <span><strong>Barricade</strong><small>@Game.AvailableBarricades in reserve</small></span>
                </button>
                @if (Game.AtBasecamp)
                {
                    <button class="button equipment-buy" disabled="@(Game.Save.Gold < Shipyard.BarricadeCost)"
                            @onclick="() => Change(Game.BuyBarricade())" aria-label="Buy barricade for @Shipyard.BarricadeCost doubloons">@Shipyard.BarricadeCost</button>
                }
            </div>
            <button class="equipment-tool" aria-pressed="@(tool == Tool.Remove)" disabled="@(Game.Loadout.Mounts.Count == 0)"
                    @onclick="() => SelectTool(Tool.Remove)">
                <EquipmentIcon />
                <strong>Remove equipment</strong>
            </button>
        </div>
    </aside>

    <section class="panel chart-panel layout-panel" aria-labelledby="outfitter-heading">
        <div class="panel-heading">
            <div><p class="eyebrow">@Game.Ship.Class</p><h2 id="outfitter-heading">@Game.Ship.Name</h2></div>
            <div class="moves"><strong>@Game.MannedCannons</strong><span>manned guns</span></div>
        </div>
        <div class="ship-readout" aria-label="Ship stats">
            <span><b>@Game.Hull</b> hull</span><span><b>@Game.Speed</b> steering speed</span>
            <span><b>@Game.DailyMoves</b> moves / day</span>
        </div>
        <div class="deck-plan">
            <div class="deck-controls" aria-label="Ship decks">
                @for (var index = 0; index < Game.Ship.Decks; index++)
                {
                    var deck = index;
                    <button class="button deck-tab" data-deck-tab="@deck" aria-pressed="@(selected.Deck == deck)" @onclick="() => SelectDeck(deck)">Deck @(deck + 1)</button>
                }
            </div>
            <div class="layout-instructions">
                <p role="status">@Instruction</p>
                @if (tool != Tool.Inspect)
                {
                    <button class="text-button" @onclick="CancelTool">Cancel selection</button>
                }
            </div>
            <ShipGrid Game="Game" Selected="selected" PickingGunner="@(tool == Tool.Gunner)" OnSelect="EditCell"
                      OnMove="MoveMount" OnPreviewDeck="SelectDeck" />
        </div>
        <div class="mount-editor">
            <div class="station-summary">
                <h3>@Station(selected)</h3>
                <p>@MountDescription</p>
            </div>
            <div class="station-actions">
                @if (Mount is not null)
                {
                    <button class="button" aria-pressed="@(tool == Tool.Move && moveSource == selected)" @onclick="BeginMove">Move equipment</button>
                }
                @if (Mount?.GunnerId is not null)
                {
                    <button class="button" @onclick="() => Change(Game.Assign(selected, null))">Unassign gunner</button>
                }
            </div>
        </div>
        <div class="layout-actions">
            @if (confirmClear)
            {
                <span>Return all mounted equipment to reserve?</span>
                <button class="button danger" @onclick="ClearLayout">Confirm clear</button>
                <button class="button" @onclick="() => confirmClear = false">Cancel</button>
            }
            else
            {
                <button class="button danger" disabled="@(Game.Loadout.Mounts.Count == 0)" @onclick="() => confirmClear = true">Clear layout</button>
            }
        </div>
    </section>

    <aside class="panel side-panel crew-panel" aria-labelledby="crew-heading">
        <div class="crew-heading">
            <h2 id="crew-heading">Crew</h2>
            <button class="button" disabled="@(Game.MannedCannons == 0)" @onclick="UnassignAll">Unassign all</button>
        </div>
        <p class="crew-count">@Game.MannedCannons assigned · @(Game.Loadout.Crew.Count - Game.MannedCannons) unassigned</p>
        <div class="crew-roster">
            @foreach (var id in Game.Loadout.Crew)
            {
                var pirate = Shipyard.GetPirate(id);
                var station = Game.Loadout.Mounts.Find(item => item.GunnerId == id);
                var isSelected = tool == Tool.Gunner && gunner == id;
                var status = station is null ? "Unassigned" : $"Assigned · {Station(station.Position)}";
                <PirateCardView @key="id" Card="pirate" Status="@status" Selected="isSelected"
                                SelectionLabel="@($"{(station is null ? "Assign" : "Reassign")} {pirate.Name}")"
                                OnSelect="() => SelectGunner(id)" />
            }
        </div>
    </aside>

    <Quartermaster Game="Game" Changed="Changed" ShipChanged="OnShipChanged" />
</div>

@code {
    [Parameter, EditorRequired] public Campaign Game { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }

    private enum Tool { Inspect, Cannon, Barricade, Remove, Gunner, Move }
    private Tool tool;
    private CannonKind cannon;
    private int gunner;
    private DeckPosition selected = new(1, 0, 0);
    private DeckPosition moveSource;
    private bool confirmClear;
    private string? feedback;
    private DeckMount? Mount => Game.MountAt(selected);
    private string Instruction => feedback ?? (tool switch
    {
        Tool.Cannon => $"Choose a cell for {Campaign.Cannons[(int)cannon].Name}.",
        Tool.Barricade => "Choose a cell for the barricade.",
        Tool.Remove => "Choose equipment to return to reserve.",
        Tool.Gunner => $"Choose a cannon for {Shipyard.GetPirate(gunner).Name}.",
        Tool.Move => "Choose a destination. Occupied cells swap equipment.",
        _ => "Drag mounted equipment to move it, or select a tool."
    });

    private string MountDescription => Mount switch
    {
        { Cannon: { } kind, GunnerId: { } id } => $"{Campaign.Cannons[(int)kind].Name} · {Shipyard.GetPirate(id).Name}",
        { Cannon: { } kind } => $"{Campaign.Cannons[(int)kind].Name} · Unmanned",
        { Barricade: true } => "Barricade",
        _ => "Empty"
    };

    private void SelectTool(Tool next)
    {
        tool = tool == next ? Tool.Inspect : next;
        feedback = null;
        confirmClear = false;
    }

    private void SelectCannon(CannonKind kind)
    {
        if (cannon != kind && tool == Tool.Cannon) tool = Tool.Inspect;
        cannon = kind;
        SelectTool(Tool.Cannon);
    }

    private void SelectGunner(int id)
    {
        if (gunner != id && tool == Tool.Gunner) tool = Tool.Inspect;
        gunner = id;
        SelectTool(Tool.Gunner);
    }

    private void BeginMove()
    {
        if (moveSource != selected && tool == Tool.Move) tool = Tool.Inspect;
        moveSource = selected;
        SelectTool(Tool.Move);
    }

    private void CancelTool()
    {
        tool = Tool.Inspect;
        feedback = null;
    }

    private void SelectDeck(int deck)
    {
        selected = selected with { Deck = deck };
        feedback = null;
    }

    private async Task EditCell(DeckPosition cell)
    {
        if (tool == Tool.Move)
        {
            await MoveMount((moveSource, cell));
            return;
        }
        selected = cell;
        feedback = null;
        confirmClear = false;
        var mount = Mount;
        switch (tool)
        {
            case Tool.Cannon when mount?.Cannon != cannon && Game.Fit(cell, cannon):
                if (Game.Available(cannon) == 0) CancelTool();
                break;
            case Tool.Barricade when mount?.Barricade != true && Game.Fit(cell, null, barricade: true):
                if (Game.AvailableBarricades == 0) CancelTool();
                break;
            case Tool.Remove when mount is not null && Game.Fit(cell, null):
                if (Game.Loadout.Mounts.Count == 0) CancelTool();
                break;
            case Tool.Gunner:
                if (!Game.Assign(cell, gunner))
                {
                    feedback = $"Choose a cannon for {Shipyard.GetPirate(gunner).Name}. This cell has no cannon.";
                    return;
                }
                CancelTool();
                break;
            default:
                return;
        }
        await Changed.InvokeAsync();
    }

    private Task MoveMount((DeckPosition Source, DeckPosition Destination) move)
    {
        if (!Game.MoveMount(move.Source, move.Destination)) return Task.CompletedTask;
        selected = move.Destination;
        confirmClear = false;
        CancelTool();
        feedback = $"Equipment moved to {Station(selected)}.";
        return Changed.InvokeAsync();
    }

    private Task UnassignAll()
    {
        Game.UnassignAll();
        CancelTool();
        feedback = "All crew are unassigned.";
        return Changed.InvokeAsync();
    }

    private Task ClearLayout()
    {
        Game.ClearLayout();
        confirmClear = false;
        CancelTool();
        feedback = "Layout cleared. Equipment is back in reserve.";
        return Changed.InvokeAsync();
    }

    private Task OnShipChanged()
    {
        if (!Game.Ship.Contains(selected)) selected = new(Game.Ship.Columns - 1, 0, 0);
        confirmClear = false;
        CancelTool();
        return Changed.InvokeAsync();
    }

    private Task Change(bool changed) => changed ? Changed.InvokeAsync() : Task.CompletedTask;
    private string Station(DeckPosition cell) => $"Deck {cell.Deck + 1} · Row {cell.Row + 1} · {Game.Ship.SideName(cell.Column)}";
}
