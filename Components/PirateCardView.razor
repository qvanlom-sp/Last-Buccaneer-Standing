<article class="pirate-card @(OnSelect.HasDelegate ? "selectable" : null) @(Selected ? "selected" : null)" aria-label="@Card.Name pirate card">
    <div class="pirate-card-heading">
        <svg class="pirate-avatar" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path class="avatar-coat" d="M7 48v-5c0-7 7-12 17-12s17 5 17 12v5Z" />
            <path class="avatar-face" d="M15 19h18v6a9 9 0 0 1-18 0Z" />
            <path class="avatar-hat" d="M7 19 12 9l7 3 5-7 5 7 7-3 5 10a34 34 0 0 1-34 0Z" />
            <path class="avatar-patch" d="M16 21h15m-12 0v4h5v-4m-3 8h6" />
        </svg>
        <div class="pirate-identity">
            <strong>@Card.Name</strong>
            @if (Status is not null) { <small>@Status</small> }
        </div>
        <div class="pirate-rating"><b>@Card.Overall.ToString("0.#")</b><small>Overall</small></div>
    </div>
    <dl>
        <div><dt>Swiftness</dt><dd>@Card.Swiftness / 100</dd></div>
        <div><dt>Accuracy</dt><dd>@Card.Accuracy / 100</dd></div>
    </dl>
    @if (OnSelect.HasDelegate)
    {
        <button class="card-select" type="button" aria-label="@SelectionLabel" aria-pressed="@Selected" @onclick="OnSelect"></button>
    }
    else
    {
        <p>@Card.Bio</p>
    }
    @ChildContent
</article>

@code {
    [Parameter, EditorRequired] public PirateCard Card { get; set; } = default!;
    [Parameter] public string? Status { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public string? SelectionLabel { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
